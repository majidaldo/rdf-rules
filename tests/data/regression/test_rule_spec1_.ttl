@prefix ns1: <urn:rdf-rules:meta:> .
@prefix ns2: <http://example.com/> .
@prefix ns3: <http://> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns2:Person1 ns2:age 30 ;
    ns3:xmlns.comname "John Doe" .

ns2:Person2 ns2:age 30 ;
    ns3:xmlns.comname "John Doe" .

[] a rdf:Statement ;
    rdf:object "John Doe" ;
    rdf:predicate ns3:xmlns.comname ;
    rdf:subject ns2:Person2 ;
    ns1:name "8ddc0cb9f84aa2b02897ebbac553ebbe97d79da3" .

[] a rdf:Statement ;
    rdf:object 30 ;
    rdf:predicate ns2:age ;
    rdf:subject ns2:Person1 ;
    ns1:name "8ddc0cb9f84aa2b02897ebbac553ebbe97d79da3" .

[] a rdf:Statement ;
    rdf:object 30 ;
    rdf:predicate ns2:age ;
    rdf:subject ns2:Person2 ;
    ns1:name "8ddc0cb9f84aa2b02897ebbac553ebbe97d79da3" .

[] a rdf:Statement ;
    rdf:object "John Doe" ;
    rdf:predicate ns3:xmlns.comname ;
    rdf:subject ns2:Person1 ;
    ns1:name "8ddc0cb9f84aa2b02897ebbac553ebbe97d79da3" .


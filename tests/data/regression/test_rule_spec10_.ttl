@prefix ns1: <http://example.com/> .
@prefix ns2: <urn:rdf-rules:meta:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:dana a ns1:Person ;
    ns1:age 16 .

ns1:bob a ns1:Employee ;
    ns1:age 29 ;
    ns1:name "Bob" .

ns1:charlie a ns1:Person ;
    ns1:age -2 ;
    ns1:name "Charlie" .

ns1:alice a ns1:Employee ;
    ns1:age 34 ;
    ns1:employeeId "EMP-1001" ;
    ns1:name "Alice" .

[] a rdf:Statement ;
    rdf:object 34 ;
    rdf:predicate ns1:age ;
    rdf:subject ns1:alice ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object "Charlie" ;
    rdf:predicate ns1:name ;
    rdf:subject ns1:charlie ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object -2 ;
    rdf:predicate ns1:age ;
    rdf:subject ns1:charlie ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object 16 ;
    rdf:predicate ns1:age ;
    rdf:subject ns1:dana ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object "Alice" ;
    rdf:predicate ns1:name ;
    rdf:subject ns1:alice ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object 29 ;
    rdf:predicate ns1:age ;
    rdf:subject ns1:bob ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object ns1:Employee ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:alice ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object "Bob" ;
    rdf:predicate ns1:name ;
    rdf:subject ns1:bob ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object ns1:Person ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:charlie ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object ns1:Employee ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:bob ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object "EMP-1001" ;
    rdf:predicate ns1:employeeId ;
    rdf:subject ns1:alice ;
    ns2:name "test" .

[] a rdf:Statement ;
    rdf:object ns1:Person ;
    rdf:predicate rdf:type ;
    rdf:subject ns1:dana ;
    ns2:name "test" .


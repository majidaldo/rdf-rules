@prefix ns1: <http://example.com/> .
@prefix ns2: <http://> .
@prefix ns3: <urn:rdf-rules:meta:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:Person1 ns1:age 30 ;
    ns2:xmlns.comname "John Doe" .

ns1:Person2 ns1:age 30 ;
    ns2:xmlns.comname "John Doe" .

[] a rdf:Statement ;
    rdf:object "John Doe" ;
    rdf:predicate ns2:xmlns.comname ;
    rdf:subject ns1:Person2 ;
    ns3:path "queries/test.rq" .

[] a rdf:Statement ;
    rdf:object "John Doe" ;
    rdf:predicate ns2:xmlns.comname ;
    rdf:subject ns1:Person1 ;
    ns3:path "queries/test.rq" .

[] a rdf:Statement ;
    rdf:object 30 ;
    rdf:predicate ns1:age ;
    rdf:subject ns1:Person2 ;
    ns3:path "queries/test.rq" .

[] a rdf:Statement ;
    rdf:object 30 ;
    rdf:predicate ns1:age ;
    rdf:subject ns1:Person1 ;
    ns3:path "queries/test.rq" .


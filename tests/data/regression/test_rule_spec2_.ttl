@prefix ns1: <urn:rdf-rules:meta:> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<http://example.com/alice> a <http://example.com/Adult> .

<http://example.com/bob> a <http://example.com/Adult> .

[] a rdf:Statement ;
    rdf:object <http://example.com/Adult> ;
    rdf:predicate rdf:type ;
    rdf:subject <http://example.com/bob> ;
    ns1:ontology "data/test-ontology.ttl" ;
    ns1:shaclmode "inference" .

[] a rdf:Statement ;
    rdf:object <http://example.com/Adult> ;
    rdf:predicate rdf:type ;
    rdf:subject <http://example.com/alice> ;
    ns1:ontology "data/test-ontology.ttl" ;
    ns1:shaclmode "inference" .

